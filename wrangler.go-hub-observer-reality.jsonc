{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-hub-eye-reality",
  "main": "go-hub-edge-worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "OBSERVER_SESSIONS",
        "class_name": "ObserverSessionRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-observer-sessions",
      "new_sqlite_classes": ["ObserverSessionRegistry"]
    }
  ],
  "vars": {
    "BROWSER_POLICY": {
      "allowedHostnames": ["gumroad.com", "*.gumroad.com"],
      "requireOwnerPasscode": true
    }
  }
}
