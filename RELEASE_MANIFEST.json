    { "path": "go-hub-piece-qc.js" },
    { "path": "go-hub-ready-gate.js" },
    { "path": "go-hub-assembly-bench.js" },
    { "path": "go-hub-assembly-qc.js" },
    { "path": "go-hub-artifact.js" },
    { "path": "go-hub-product-qc.js" },
    { "path": "go-hub-workbench-model.js" },
    { "path": "go-hub-github-workspace.js" },
    { "path": "go-hub-persistence.js" },
    { "path": "go-hub-sw-bootstrap.js" },
    { "path": "go-hub-sw.js" }
  ]
}
