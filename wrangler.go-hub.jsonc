{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-hub",
  "main": "go-hub-entry.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/hub/api/github-workspace/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GO_HUB_FACTORY_STATE",
        "class_name": "GoHubFactoryState"
      }
    ]
  },
  "exports": {
    "GoHubFactoryState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
