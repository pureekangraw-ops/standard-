{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-hub",
  "main": "go-hub-edge-worker.mjs",
  "compatibility_date": "2026-09-14",
  "keep_vars": true,
  "secrets": {
    "required": ["LINEAR_API_KEY"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HEPHAESTUS",
        "class_name": "HephaestusForeman"
      },
      {
        "name": "OBSERVER_SESSIONS",
        "class_name": "ObserverSessionRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-hephaestus-foreman",
      "new_sqlite_classes": ["HephaestusForeman"]
    },
    {
      "tag": "v2-browser-observer-sessions",
      "new_sqlite_classes": ["ObserverSessionRegistry"]
    }
  ],
  "vars": {
    "BROWSER_POLICY": {
      "allowedHostnames": [
        "gumroad.com",
        "*.gumroad.com"
      ],
      "requireOwnerPasscode": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/hub/api/browser/*",
      "/hub/api/github-workspace/*",
      "/hub/observer",
      "/mcp",
      "/oauth/*",
      "/.well-known/*"
    ]
  }
}
